# Documentation only; GitHub Pages does not inject these into static JavaScript.
# Server-side values must be configured in Supabase, never published in assets.
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
# For a future server-side checkout/API function; webhook does not need this key.
PADDLE_API_KEY=
# Public build-time checkout settings. Keep checkout disabled until all gates pass.
PUBLIC_PADDLE_CHECKOUT_ENABLED=false
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_STARTER_PRICE_ID=
PUBLIC_PADDLE_PRO_PRICE_ID=
PUBLIC_PADDLE_STUDIO_PREMIUM_PRICE_ID=
